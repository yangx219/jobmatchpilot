# Run node scripts/setup-local.mjs to generate private .env with stable secrets.
POSTGRES_PASSWORD=
POSTGRES_USER=jobmatchpilot
POSTGRES_DB=jobmatchpilot
POSTGRES_VOLUME_NAME=jobmatchpilot_pgdata
DATABASE_URL=postgres://jobmatchpilot:CHANGE_ME@localhost:55432/jobmatchpilot
AUTH_SECRET=
ENCRYPTION_KEY=
NEXTAUTH_URL=http://localhost:3737
AUTH_TRUST_HOST=true
TZ=Europe/Paris
# all for local development; Docker assigns web/worker per service.
JOBMATCHPILOT_PROCESS_ROLE=all
MCP_ENABLED=false
# Optional: collection-only automations do not require AI credentials.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Optional public multi-platform collector: run sh scripts/setup-collectors.sh.
# Set this only if Python is installed elsewhere (never put API keys here).
# JOBSPY_PYTHON=/absolute/path/to/python
